{
  "schemaVersion": 1,
  "id": "marchybar.touchbar",
  "name": "MarchyBar",
  "version": "0.1.0",
  "author": "MarchyBar contributors",
  "license": "GPL-3.0-or-later",
  "description": "Editable Touch Bar presets and live controls for Intel T2 Macs, with experimental M1/M2 support on Omarchy.",
  "kinds": ["bar-widget", "panel", "service"],
  "keepLoaded": true,
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "panel": "Editor.qml",
    "service": "Service.qml"
  },
  "barWidget": {
    "displayName": "MarchyBar",
    "description": "Touch Bar presets and settings",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
