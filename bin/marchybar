#!/bin/bash
set -euo pipefail
MARCHYBAR_ROOT=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)

prepare() {
  local runtime fingerprint build_dir
  runtime=$(node -e '
    try {
      require(process.argv[1]);
      console.log("local");
    } catch {
      console.log(`${process.platform}/${process.arch}`);
    }
  ' "$MARCHYBAR_ROOT/build/Release/drm_backend.node")
  if [[ "$runtime" == local ]]; then
    export MARCHYBAR_NATIVE_PATH="$MARCHYBAR_ROOT/build/Release/drm_backend.node"
    return
  fi
  fingerprint=$(python3 - "$MARCHYBAR_ROOT" "$runtime" <<'PY'
import hashlib,sys
from pathlib import Path
p=Path(sys.argv[1]);h=hashlib.sha256()
h.update(sys.argv[2].encode()+b'\0')
for f in sorted((p/'native/src').glob('*'))+[p/'package.json',p/'package-lock.json',p/'binding.gyp']:
  h.update(f.read_bytes())
print(h.hexdigest()[:20])
PY
)
  build_dir="${XDG_CACHE_HOME:-$HOME/.cache}/marchybar/native/$fingerprint"
  export MARCHYBAR_NATIVE_PATH="$build_dir/build/Release/drm_backend.node"
  mkdir -p "$build_dir"
  (
    flock 9
    if [[ -f "$build_dir/.complete" && -s $MARCHYBAR_NATIVE_PATH ]]; then exit 0; fi
    # Keep the lock inode stable; only completed builds may be reused.
    local staging_dir="$build_dir/.staging"
    rm -f -- "$build_dir/.complete"
    rm -rf -- "$staging_dir"
    mkdir -p "$staging_dir"
    trap 'rm -rf -- "$staging_dir"' EXIT
    echo "Preparing MarchyBar's renderer…" >&2
    pkg-config --exists cairo libdrm pangocairo librsvg-2.0 || {
      echo "Missing build libraries. See README.md → Setup." >&2; exit 1;
    }
    cp "$MARCHYBAR_ROOT/package.json" "$MARCHYBAR_ROOT/package-lock.json" "$MARCHYBAR_ROOT/binding.gyp" "$staging_dir/"
    cp -R "$MARCHYBAR_ROOT/native" "$staging_dir/"
    (cd "$staging_dir" && npm ci --ignore-scripts --include=dev && npm run build) >&2
    [[ -s "$staging_dir/build/Release/drm_backend.node" ]] || {
      echo "Renderer build did not produce drm_backend.node." >&2; exit 1;
    }
    rm -rf -- "$build_dir/build"
    mv -- "$staging_dir/build" "$build_dir/build"
    touch "$build_dir/.complete"
  ) 9>"$build_dir/.lock"
}

action=${1:-open}
if (( $# )); then shift; fi
case "$action" in
  prepare) prepare ;;
  daemon) prepare; exec node "$MARCHYBAR_ROOT/backend/server.mjs" "$@" ;;
  preview) prepare; exec node "$MARCHYBAR_ROOT/backend/server.mjs" --preview "$@" ;;
  open) exec omarchy-shell shell summon marchybar.touchbar '{}' ;;
  setup) exec /usr/bin/python3 -I "$MARCHYBAR_ROOT/bin/system-action.py" setup "$@" ;;
  update) exec /bin/bash "$MARCHYBAR_ROOT/bin/update.sh" "$@" ;;
  uninstall-system) exec /usr/bin/python3 -I "$MARCHYBAR_ROOT/bin/system-action.py" remove "$@" ;;
  help|--help|-h)
    cat <<'HELP'
MarchyBar — native Omarchy Touch Bar configuration

  marchybar open                     Open the native preset editor
  marchybar prepare                  Build the isolated native renderer cache
  marchybar daemon                   Run the session backend
  marchybar preview [--socket PATH]   Run without touching hardware
  marchybar setup                    Install the privileged device helper
  marchybar update [--with-omarchy]   Update MarchyBar, optionally Omarchy too
  marchybar status                   Show status and active preset
  marchybar list                     List presets
  marchybar apply ID                 Pin a preset
  marchybar auto                     Resume automatic app layouts
  marchybar enable | disable         Use MarchyBar / release hardware (Asahi: dark)
  marchybar import FILE              Import an editable preset
  marchybar export ID FILE           Export a preset as JSON
  marchybar diagnostics              Print hardware/backend diagnostics
  marchybar uninstall-system         Remove the device helper; keep presets
  marchybar request METHOD JSON      Send a protocol request (advanced)

Set MARCHYBAR_SOCKET to target an isolated preview instance.
HELP
    ;;
  *) exec node "$MARCHYBAR_ROOT/backend/cli.mjs" "$action" "$@" ;;
esac
