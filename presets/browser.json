{
  "schemaVersion": 1,
  "id": "browser",
  "name": "Browser",
  "description": "Browse and switch tabs without breaking your flow.",
  "defaultPage": "main",
  "fnPage": "function",
  "pages": [
    {
      "id": "main",
      "name": "Main",
      "widgets": [
        {
          "id": "back",
          "type": "button",
          "weight": 1,
          "label": "Back",
          "action": {
            "type": "key",
            "key": "Left",
            "modifiers": [
              "alt"
            ]
          }
        },
        {
          "id": "forward",
          "type": "button",
          "weight": 1,
          "label": "Forward",
          "action": {
            "type": "key",
            "key": "Right",
            "modifiers": [
              "alt"
            ]
          }
        },
        {
          "id": "reload",
          "type": "button",
          "weight": 1,
          "label": "Reload",
          "action": {
            "type": "key",
            "key": "r",
            "modifiers": [
              "ctrl"
            ]
          }
        },
        {
          "id": "new-tab",
          "type": "button",
          "weight": 1,
          "label": "New tab",
          "action": {
            "type": "key",
            "key": "t",
            "modifiers": [
              "ctrl"
            ]
          }
        },
        {
          "id": "previous-tab",
          "type": "button",
          "weight": 1,
          "label": "Previous",
          "action": {
            "type": "key",
            "key": "Tab",
            "modifiers": [
              "ctrl",
              "shift"
            ]
          }
        },
        {
          "id": "next-tab",
          "type": "button",
          "weight": 1,
          "label": "Next tab",
          "action": {
            "type": "key",
            "key": "Tab",
            "modifiers": [
              "ctrl"
            ]
          }
        },
        {
          "id": "address",
          "type": "button",
          "weight": 1,
          "label": "Address",
          "action": {
            "type": "key",
            "key": "l",
            "modifiers": [
              "ctrl"
            ]
          }
        },
        {
          "id": "volume",
          "type": "slider",
          "weight": 2,
          "label": "Volume",
          "channel": "volume"
        },
        {
          "id": "clock",
          "type": "clock",
          "weight": 1,
          "label": "Clock"
        }
      ]
    },
