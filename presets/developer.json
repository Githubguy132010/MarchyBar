{
  "schemaVersion": 1,
  "id": "developer",
  "name": "Developer",
  "description": "Terminal and editor shortcuts with live system stats.",
  "defaultPage": "main",
  "fnPage": "function",
  "pages": [
    {
      "id": "main",
      "name": "Main",
      "widgets": [
        {
          "id": "workspaces",
          "type": "workspaces",
          "weight": 2,
          "label": "Workspaces"
        },
        {
          "id": "search",
          "type": "button",
          "weight": 1,
          "label": "Find",
          "action": {
            "type": "key",
            "key": "f",
            "modifiers": [
              "ctrl"
            ]
          }
        },
        {
          "id": "save",
          "type": "button",
          "weight": 1,
          "label": "Save",
          "action": {
            "type": "key",
            "key": "s",
            "modifiers": [
              "ctrl"
            ]
          }
        },
        {
          "id": "terminal",
          "type": "button",
          "weight": 1,
          "label": "Terminal",
          "action": {
            "type": "command",
            "argv": [
              "omarchy",
              "launch",
              "terminal"
            ]
          }
        },
        {
          "id": "cpu",
          "type": "cpu",
          "weight": 1,
          "label": "CPU"
        },
        {
          "id": "memory",
          "type": "memory",
          "weight": 1,
          "label": "Memory"
        },
        {
          "id": "volume",
