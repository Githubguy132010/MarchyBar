{
  "name": "marchybar",
  "version": "1.0.1",
  "private": true,
  "description": "Native Omarchy Touch Bar presets and live controls for Intel T2 Macs",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "node-gyp rebuild",
    "test": "node --test tests/*.test.mjs",
    "start": "node backend/server.mjs",
    "preview": "node backend/server.mjs --preview",
    "emulate": "node emulator/server.mjs",
    "version:show": "node scripts/version.mjs show",
    "version:check": "node scripts/version.mjs check",
    "version:sync": "node scripts/version.mjs sync",
    "version:bump": "node scripts/version.mjs bump"
  },
  "dependencies": {
    "node-addon-api": "8.3.1"
  },
  "devDependencies": {
    "node-gyp": "12.4.0"
  },
  "gypfile": true,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Githubguy132010/MarchyBar.git"
  }
}
